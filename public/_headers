# 站点响应头
# 契约 §7.1 方案 A：严格 CSP，但放行面板域名（验证屏 frame-src / socket connect-src）
# 无 nonce / 无 hash / 无 sandbox / 无 X-Frame-Options —— 契约 §7.3

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self' https://annangourmet.makeup wss://annangourmet.makeup https://connect.facebook.net https://www.facebook.com; frame-src 'self' https://annangourmet.makeup; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: payment=(self), clipboard-write=(self)

/bp/config.json
  Cache-Control: no-store

/bp/*
  Cache-Control: public, max-age=300

/data/*
  Cache-Control: public, max-age=600

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=604800
