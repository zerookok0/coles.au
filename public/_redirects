# Cloudflare Pages rewrites (status 200 = proxy, URL stays as requested).
# Static files win over these prefix rules, so /bp/*, /assets/*, /img/* and
# /data/* are served untouched.
#
# /checkout is shipped as a flat checkout.html (no checkout/ directory) because
# Pages answers a directory index with a 308 redirect — which the /bp contract
# forbids on this route.

/checkout        /checkout.html   200
/checkout/       /checkout.html   200

/shop            /index.html   200
/category/*      /index.html   200
/product/*       /index.html   200
/search          /index.html   200
/cart            /index.html   200
/account         /index.html   200
/account/*       /index.html   200
/order/*         /index.html   200
/terms           /index.html   200
/privacy         /index.html   200
/returns         /index.html   200
/delivery        /index.html   200
/click-collect   /index.html   200
/flybuys         /index.html   200
/cookies         /index.html   200
/accessibility   /index.html   200
/contact         /index.html   200
/stores          /index.html   200
